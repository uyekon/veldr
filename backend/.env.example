NODE_ENV=development
PORT=5000

DB_DIALECT=sqlite
DB_STORAGE=public/data/cms.sqlite
SECURITY_DB_STORAGE=public/data/security.sqlite
DB_LOGGING=false

# CMS relational store. Keep json until the migration command has completed.
CMS_STORE=json
CMS_DATABASE_URL=postgresql://veldr_cms:change-me@127.0.0.1:5432/veldr_cms
CMS_DATABASE_SSL=false
CMS_DATABASE_POOL_MAX=10
CMS_OWNER_ID=00000000-0000-7000-8000-000000000001

UPLOAD_DIR=public/uploads
TEMP_DIR=temp

CORS_ORIGIN=http://localhost:5173,http://localhost:5174

ADMIN_USERNAME=admin
DEFAULT_PASSWORD=change-me-before-production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=60d
AUTH_COOKIE_NAME=veldr_auth
AUTH_COOKIE_MAX_AGE_MS=5184000000
# 站点通过 HTTPS 提供服务时设为 true；纯 HTTP 部署必须为 false，否则浏览器丢弃登录 Cookie
AUTH_COOKIE_SECURE=false

CMS_DATA_DIR=public/data/cms
CMS_DB_FILE=db.json
CMS_UPLOAD_DIR=public/uploads/cms
