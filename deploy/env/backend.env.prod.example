NODE_ENV=production
PORT=5000

DB_DIALECT=sqlite
CMS_STORE=json
CMS_DATABASE_URL=postgresql://veldr_cms:change-me@127.0.0.1:5432/veldr_cms
CMS_DATABASE_SSL=false
CMS_DATABASE_POOL_MAX=10
# Generate once with: node -e "console.log(require('crypto').randomUUID())"
CMS_OWNER_ID=00000000-0000-7000-8000-000000000001
CMS_POSTGRES_BACKUP_DIR=/opt/veldr/backups/cms-postgres
# RESTIC_REPOSITORY=sftp:backup-user@backup-host:/srv/restic/veldr-cms
# RESTIC_PASSWORD_FILE=/etc/veldr/restic-password
DB_STORAGE=public/data/cms.sqlite
SECURITY_DB_STORAGE=public/data/security.sqlite
DB_LOGGING=false

UPLOAD_DIR=public/uploads
TEMP_DIR=temp

CORS_ORIGIN=https://notes.lifetip.top,https://cms.lifetip.top

ADMIN_USERNAME=admin
DEFAULT_PASSWORD=replace-initial-admin-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=60d
AUTH_COOKIE_NAME=veldr_auth
AUTH_COOKIE_MAX_AGE_MS=5184000000
# HTTPS 上线后改为 true；站点仍是纯 HTTP 时必须为 false，否则浏览器丢弃登录 Cookie
AUTH_COOKIE_SECURE=false

CMS_DATA_DIR=public/data/cms
CMS_DB_FILE=db.json
CMS_UPLOAD_DIR=public/uploads/cms
